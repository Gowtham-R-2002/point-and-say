# =============================================
# Point & Say UI — Environment Configuration
# =============================================

# AWS Credentials (required for Nova models)
# Get these from: AWS Console → IAM → Security Credentials
AWS_ACCESS_KEY_ID=your-key-here
AWS_SECRET_ACCESS_KEY=your-secret-here
AWS_REGION=us-east-1

# Bedrock region (defaults to AWS_REGION)
# BEDROCK_REGION=us-east-1

# Nova model overrides (optional — defaults shown)
# Vision grounding + verification: Nova 2 Lite (multimodal)
# NOVA_LITE_MODEL_ID=amazon.nova-lite-v2:0
# Code generation: Nova Premier (flagship, 1M context, superior reasoning + code gen)
# NOVA_CODEGEN_MODEL_ID=amazon.nova-premier-v1:0

# Server port (optional — defaults to 8000)
# SERVER_PORT=8000

# Frontend API URL (optional — defaults to http://localhost:8000)
# VITE_API_URL=http://localhost:8000
